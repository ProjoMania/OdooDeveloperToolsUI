# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
DATABASE_URL=sqlite:///dev_tools.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SSH Configuration
SSH_CONFIG_DIR=~/.ssh/config.d
SSH_DEFAULT_PORT=22
SSH_TIMEOUT=30

# Odoo Configuration
FILESTORE_DIR=~/.local/share/Odoo/filestore
ODOO_DEFAULT_PORT=8069

# API Configuration
DJANGO_PORTAL_URL=http://127.0.0.1:8000
API_TIMEOUT=30

# File Upload Configuration
UPLOAD_FOLDER=/tmp/odoo_dev_tools_uploads
MAX_CONTENT_LENGTH=524288000

# Logging Configuration
LOG_LEVEL=INFO

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Pagination
ITEMS_PER_PAGE=20

# Subscription Portal
SUBSCRIPTION_PORTAL_URL=https://projomania.com/subscription 